# Copier ce fichier en `.env` (jamais commité) puis adapter.
# Valeurs par défaut = infra locale `make up`. Aucun secret réel ici.

STAR_PULSE_ENVIRONMENT=local
STAR_PULSE_LOG_LEVEL=INFO
STAR_PULSE_LOG_JSON=false

# Redpanda (API Kafka)
STAR_PULSE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# MinIO / S3 (identifiants de dev locaux, à changer hors laptop)
STAR_PULSE_S3_ENDPOINT_URL=http://localhost:9000
STAR_PULSE_S3_ACCESS_KEY=minioadmin
STAR_PULSE_S3_SECRET_KEY=change-me-local-only
STAR_PULSE_S3_BUCKET=lake

# Sources open data
STAR_PULSE_GTFS_STATIC_URL=https://eu.ftp.opendatasoft.com/star/gtfs/GTFS_STAR_BUS_METRO_EN_COURS.zip
STAR_PULSE_HTTP_USER_AGENT="star-pulse/0.1 (projet portfolio open data)"
STAR_PULSE_POLL_INTERVAL_S=30
